<script>
  // Copy class on click
  document.querySelectorAll<HTMLElement>('.copy-class').forEach(el => {
    el.addEventListener('click', () => {
      navigator.clipboard.writeText(el.textContent!.trim()).then(() => {
        (window as any).ubToast?.(`Copied ${el.textContent!.trim()}`);
      });
    });
  });

  // Copy code snippet
  document.querySelectorAll<HTMLButtonElement>('.copy-code-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.code!).then(() => {
        (window as any).ubToast?.('Copied code snippet');
      });
    });
  });

  // Copy CDN
  document.getElementById('btn-copy-cdn-docs')?.addEventListener('click', () => {
    navigator.clipboard.writeText('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@1.0.0/dist/unboilerplate.min.css">').then(() => {
      (window as any).ubToast?.('Copied CDN tag');
    });
  });
</script>

