<DocsLayout
  title="API Reference — Unboilerplate"
  description="Complete class reference, design tokens, installation guide, and usage examples for the Unboilerplate pure CSS design system."
  activePage="docs"
  tocItems={tocItems}
>

  <!-- SIDEBAR -->
  <div slot="sidebar">
    <p class="sidebar-group-title">API Reference</p>
    <div class="sidebar-links">
      <a href="#installation"   class="sidebar-link active">Installation</a>
      <a href="#tokens"         class="sidebar-link">Design Tokens</a>
      <a href="#utilities"      class="sidebar-link">Utility Classes</a>
      <a href="#components"     class="sidebar-link">Magic Components</a>
      <a href="#effects"        class="sidebar-link">Visual Effects</a>
      <a href="#animations"     class="sidebar-link">Animations</a>
      <a href="#dimensions-3d"  class="sidebar-link">3D Dimensions</a>
      <a href="#retro"          class="sidebar-link">Retro / Time Machine</a>
      <a href="#themes"         class="sidebar-link">Aesthetic Themes</a>
      <a href="#modifiers"      class="sidebar-link">Modifiers</a>
    </div>

    <p class="sidebar-group-title" style="margin-top:1.5rem;">Explore</p>
    <div class="sidebar-links">
      <a href="/"           class="sidebar-link">Get Started</a>
      <a href="/playground" class="sidebar-link" style="color:#00f2fe;font-weight:700;">Playground</a>
      <a href="/components" class="sidebar-link">Component Library</a>
      <a href="/cheatsheet" class="sidebar-link">Class Cheatsheet</a>
      <a href="/templates"  class="sidebar-link">Templates</a>
      <a href="/showcase"   class="sidebar-link">Showcase</a>
    </div>
  </div>

  <!-- TOC CARD -->
  <div slot="toc-card" style="margin-top:2rem;padding:1rem;background:rgba(0,242,254,0.05);border:1px solid rgba(0,242,254,0.15);border-radius:12px;">
    <p style="font-size:0.78rem;font-weight:700;color:#fff;margin-bottom:0.5rem;">Quick CDN Install</p>
    <code style="font-size:0.7rem;color:#00f2fe;word-break:break-all;display:block;line-height:1.5;">
      &lt;link rel="stylesheet"<br>
      href="cdn.jsdelivr.net/npm/<br>@eldrex/unboilerplate@1.0.0/<br>dist/unboilerplate.min.css"&gt;
    </code>
    <button id="btn-copy-cdn-docs" class="vibe-btn --sm" style="margin-top:0.75rem;font-size:0.72rem;width:100%;">Copy CDN Tag</button>
  </div>

  <!-- MAIN CONTENT -->
  <div id="installation">
    <div class="docs-breadcrumb">
      <a href="/" style="color:#64748b;text-decoration:none;">Unboilerplate</a>
      <span>›</span>
      <span>API Reference</span>
    </div>

    <h1 class="docs-page-title text-gradient">API Reference</h1>
    <p class="docs-lead">Every class, token, and modifier in the Unboilerplate CSS system. 120+ classes documented with descriptions and usage examples.</p>

    <!-- Installation -->
    <div class="callout-box" style="margin-top:1.5rem;">
      <strong>Zero build step required.</strong> Drop one stylesheet link into your HTML head to enable the entire design engine. No npm, no bundler, no config.
    </div>

    <h2 style="font-size:1.4rem;margin-top:2rem;">Option 1: CDN (Instant)</h2>
    <p style="color:#94a3b8;font-size:0.9rem;margin:0.5rem 0 0.75rem;">Paste into your HTML <code>&lt;head&gt;</code>:</p>
    <div class="docs-code-card">
      <div class="docs-code-header">
        <span>HTML</span>
        <button class="pill-tab copy-code-btn" data-code='<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@1.0.0/dist/unboilerplate.min.css">'>Copy</button>
      </div>
      <div class="docs-code-body">
        &lt;!-- Full bundle (3D, Retro, Art Movements, Effects) --&gt;<br>
        &lt;link rel="stylesheet"<br>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@1.0.0/dist/unboilerplate.min.css"&gt;
      </div>
    </div>

    <h2 style="font-size:1.4rem;margin-top:1.75rem;">Option 2: npm</h2>
    <p style="color:#94a3b8;font-size:0.9rem;margin:0.5rem 0 0.75rem;">Install and import in your project:</p>
    <div class="docs-code-card">
      <div class="docs-code-header"><span>Terminal</span></div>
      <div class="docs-code-body">npm install @eldrex/unboilerplate</div>
    </div>
    <div class="docs-code-card">
      <div class="docs-code-header"><span>JavaScript / TypeScript</span></div>
      <div class="docs-code-body">import '@eldrex/unboilerplate';</div>
    </div>
    <div class="docs-code-card">
      <div class="docs-code-header"><span>CSS</span></div>
      <div class="docs-code-body">@import '@eldrex/unboilerplate';</div>
    </div>

