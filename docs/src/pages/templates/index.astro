  'dark-academia': `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Atheneum — Journal of Arts & Letters</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@latest/dist/unboilerplate.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">
</head>
<body class="theme-dark-academia" style="margin:0;padding:0;min-height:100vh;font-family:'Newsreader',serif;">

  <header style="padding:3.5rem 2rem;text-align:center;border-bottom:1px solid var(--ub-border);">
    <p style="font-family:'Cinzel',serif;letter-spacing:0.4em;font-size:0.75rem;color:var(--ub-accent);margin-bottom:0.5rem;">EST. MMXXVI &middot; VOLUME IX</p>
    <h1 style="font-family:'Cinzel',serif;font-size:clamp(2.2rem,6vw,4rem);margin:0;letter-spacing:0.05em;">THE ATHENEUM</h1>
    <p style="font-size:1.05rem;font-style:italic;color:var(--ub-text-muted);margin-top:0.6rem;">"Knowledge. Curiosity. The Examined Life."</p>
  </header>

  <main style="max-width:820px;margin:0 auto;padding:4rem 2rem;">
    <article class="vibe-card p-8" style="margin-bottom:3rem;">
      <span class="vibe-badge" style="margin-bottom:1rem;display:inline-block;">FEATURED ESSAY</span>
      <h2 style="font-family:'Cinzel',serif;font-size:clamp(1.6rem,3.5vw,2.4rem);margin-bottom:1rem;line-height:1.2;">On the Virtue of Slowness in the Digital Age</h2>
      <p style="line-height:1.85;font-size:1.1rem;color:var(--ub-text);margin-bottom:1.5rem;">
        The ancients understood something we have forgotten: that depth requires time. Wisdom emerges not from the incessant flood of real-time feeds, but from the quiet pool where thought can settle and take root.
      </p>
      <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--ub-border);padding-top:1rem;font-size:0.85rem;color:var(--ub-text-muted);">
        <span>By Julian Hawthorne</span>
        <span>12 Min Read</span>
      </div>
    </article>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:1.5rem;">
      <div class="vibe-card p-6">
        <span class="vibe-badge" style="font-size:0.65rem;">POETRY</span>
        <h3 style="font-family:'Cinzel',serif;font-size:1.15rem;margin:0.5rem 0;">Letters to Keats</h3>
        <p style="font-size:0.9rem;color:var(--ub-text-muted);line-height:1.6;">Odes to forgotten autumn rains and quiet libraries.</p>
      </div>
      <div class="vibe-card p-6">
        <span class="vibe-badge" style="font-size:0.65rem;">PHILOSOPHY</span>
        <h3 style="font-family:'Cinzel',serif;font-size:1.15rem;margin:0.5rem 0;">The Geometry of Solitude</h3>
        <p style="font-size:0.9rem;color:var(--ub-text-muted);line-height:1.6;">Reflections on Marcus Aurelius and cognitive space.</p>
      </div>
    </div>
  </main>

</body>
</html>`,

  'clean-girl': `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sofia Lim — Design Studio</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@latest/dist/unboilerplate.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;900&display=swap" rel="stylesheet">
</head>
<body class="theme-clean-girl" style="margin:0;padding:0;min-height:100vh;font-family:'Plus Jakarta Sans',sans-serif;">

  <nav style="padding:1.75rem 2.5rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ub-border);">
    <span style="font-weight:900;letter-spacing:-0.03em;font-size:1.1rem;">sofia lim</span>
    <div style="display:flex;gap:2rem;font-size:0.88rem;font-weight:600;">
      <a href="#work" style="color:var(--ub-text);text-decoration:none;">work</a>
      <a href="#about" style="color:var(--ub-text-muted);text-decoration:none;">about</a>
      <a href="#contact" style="color:var(--ub-text-muted);text-decoration:none;">contact</a>
    </div>
  </nav>

  <main style="max-width:1100px;margin:0 auto;padding:5rem 2rem;">
    <div style="margin-bottom:5rem;">
      <span class="vibe-badge" style="background:#000;color:#fff;font-size:0.7rem;letter-spacing:0.1em;">PRODUCT &amp; BRAND DESIGN</span>
      <h1 style="font-size:clamp(2.6rem,7vw,4.5rem);font-weight:900;line-height:1.08;letter-spacing:-0.04em;margin:1rem 0 1.25rem;">I craft digital products<br>that feel inevitable.</h1>
