<script define:vars={{ templateSnippets }} is:inline>
  document.querySelectorAll('.copy-tpl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.tpl;
      navigator.clipboard.writeText(templateSnippets[key]).then(() => {
        // Visual feedback on button
        const orig = btn.textContent;
        btn.textContent = '✓ Copied!';
        btn.style.background = 'linear-gradient(180deg,#00ffa3,#00d680)';
        btn.style.color = '#000';
        setTimeout(() => {
          btn.textContent = orig;
          btn.style.background = '';
          btn.style.color = '';
        }, 2000);
        (window).ubToast?.('Template HTML copied to clipboard!');
      });
    });
  });
</script>

