  cube: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3D Spatial Photo Cube — Unboilerplate</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@latest/dist/unboilerplate.min.css">
</head>
<body style="background:#06070a;color:#f3f4f8;margin:0;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem;">

  <div style="text-align:center;margin-bottom:3rem;">
    <span class="vibe-badge vibe-badge--neon">HARDWARE ACCELERATED</span>
    <h1 class="text-gradient --ocean" style="font-size:clamp(2rem,5vw,3.5rem);font-weight:900;margin:0.5rem 0;">Pure CSS 3D Spatial Matrix</h1>
    <p style="color:#64748b;font-size:0.95rem;">Hover anywhere on the 3D cube to inspect perspectives.</p>
  </div>

  <div class="cube-3d-scene" style="margin:2rem 0 4rem;">
    <div class="cube-3d">
      <div class="cube-face --front">
        <h3 class="text-gradient">NEBULA</h3>
      </div>
      <div class="cube-face --back">
        <h3 class="text-cyber">TOKYO</h3>
      </div>
      <div class="cube-face --left">
        <h3 class="text-neon">HORIZON</h3>
      </div>
      <div class="cube-face --right">
        <h3 class="text-fire">SOLAR</h3>
      </div>
      <div class="cube-face --top">
        <h3 class="text-ice">ZENITH</h3>
      </div>
      <div class="cube-face --bottom">
        <h3 class="text-3d">CORE</h3>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
    <button class="btn-3d btn-3d--cyan">INTERACT 3D</button>
    <button class="pill-tab">transform-style: preserve-3d</button>
  </div>

</body>
</html>`,

  polaroid: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Summer Memories — Polaroid Gallery</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@latest/dist/unboilerplate.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;900&family=Caveat:wght@700&display=swap" rel="stylesheet">
</head>
<body style="background:#0e1017;color:#f3f4f8;margin:0;padding:4rem 2rem;font-family:'Plus Jakarta Sans',sans-serif;">

  <div style="max-width:1000px;margin:0 auto;text-align:center;">
    <span class="vibe-badge vibe-badge--sunset">SPRING HOVER ELEVATION</span>
    <h1 style="font-size:clamp(2rem,6vw,3.6rem);font-weight:900;margin:0.5rem 0 1rem;">Wanderlust Scrapbook</h1>
    <p style="color:#94a3b8;max-width:540px;margin:0 auto 3rem;line-height:1.6;">Hover over each physical polaroid frame to elevate and bring it into spatial focus.</p>

    <div class="polaroid-stack" style="display:flex;flex-wrap:wrap;justify-content:center;gap:2rem;margin:2rem 0;">
      <figure class="polaroid --rotate-left" style="width:240px;background:#fff;padding:12px 12px 24px;border-radius:4px;box-shadow:0 15px 35px rgba(0,0,0,0.6);">
        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=500&auto=format&fit=crop&q=80" alt="Pacific Coast" style="width:100%;aspect-ratio:1/1;object-fit:cover;" />
        <figcaption style="color:#111;font-family:'Caveat',cursive;font-size:1.3rem;margin-top:10px;">Pacific Coast Sunrise ☀️</figcaption>
      </figure>

      <figure class="polaroid --on-top" style="width:240px;background:#fff;padding:12px 12px 24px;border-radius:4px;box-shadow:0 20px 45px rgba(0,0,0,0.7);">
        <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=500&auto=format&fit=crop&q=80" alt="Route 66" style="width:100%;aspect-ratio:1/1;object-fit:cover;" />
        <figcaption style="color:#111;font-family:'Caveat',cursive;font-size:1.3rem;margin-top:10px;">Route 66 Highway 🚙</figcaption>
      </figure>

      <figure class="polaroid --rotate-right" style="width:240px;background:#fff;padding:12px 12px 24px;border-radius:4px;box-shadow:0 15px 35px rgba(0,0,0,0.6);">
        <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=500&auto=format&fit=crop&q=80" alt="Alpine Cabin" style="width:100%;aspect-ratio:1/1;object-fit:cover;" />
        <figcaption style="color:#111;font-family:'Caveat',cursive;font-size:1.3rem;margin-top:10px;">Alpine Pass Ascent 🏔️</figcaption>
      </figure>
    </div>
  </div>

</body>
</html>`,

  vaporwave: `<!DOCTYPE html>
