---
import DocsLayout from '../../layouts/DocsLayout.astro';

const tocItems: Array<{ id: string; label: string }> = [];

const templateSnippets: Record<string, string> = {
  artist: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Elena Vance — Creative Technologist & Digital Artist</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@latest/dist/unboilerplate.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body style="background:#06070a;color:#f3f4f8;margin:0;font-family:'Plus Jakarta Sans',sans-serif;overflow-x:hidden;">

  <nav style="padding:1.25rem 2rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(6,7,10,0.8);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-weight:900;font-size:1.1rem;letter-spacing:-0.03em;">ELENA VANCE</span>
      <span class="vibe-badge vibe-badge--neon">STUDIO</span>
    </div>
    <div style="display:flex;gap:1.5rem;font-size:0.88rem;align-items:center;">
      <a href="#works" style="color:#94a3b8;text-decoration:none;font-weight:600;">Works</a>
      <a href="#about" style="color:#94a3b8;text-decoration:none;font-weight:600;">About</a>
      <a href="#contact" class="vibe-btn --sm" style="text-decoration:none;">Let's Talk</a>
    </div>
  </nav>

  <header class="hero-creative" style="position:relative;padding:clamp(4rem,10vw,8rem) 2rem;text-align:center;overflow:hidden;min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;">
    <div class="hero-bg gradient-aurora"></div>
    <div style="max-width:800px;position:relative;z-index:10;">
      <span class="vibe-badge vibe-badge--neon mb-3">DIGITAL SPATIAL ARCHITECTURE</span>
      <h1 class="text-gradient font-bold" style="font-size:clamp(2.5rem,7vw,5rem);line-height:1.05;margin:0.5rem 0 1rem;">Creative Technologist &amp; Visual Artist</h1>
      <p class="text-animate --typewriter" style="font-size:clamp(1rem,2vw,1.25rem);color:#cbd5e1;max-width:620px;margin:0 auto 2rem;line-height:1.6;">
        Sculpting generative physics, pure CSS hardware shaders, and emotional spatial dimensions.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="#works" class="vibe-btn hover-bounce">View Selected Works ↓</a>
        <a href="#contact" class="pill-tab" style="padding:0.7rem 1.5rem;">Commission Work</a>
      </div>
    </div>
  </header>

  <main style="max-width:1200px;margin:0 auto;padding:4rem 2rem;">
    <section id="works" style="margin-bottom:6rem;">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;flex-wrap:wrap;gap:1rem;">
        <div>
          <span class="vibe-badge vibe-badge--sunset">SELECTED EXHIBITIONS</span>
          <h2 style="font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;margin-top:0.4rem;">Featured Canvases</h2>
        </div>
        <p style="color:#64748b;font-size:0.9rem;max-width:340px;">Interactive 3D compositions generated with zero JavaScript overhead.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:2rem;">
        <article class="vibe-card hover-lift p-4" style="background:#0c0e17;border:1px solid rgba(255,255,255,0.08);border-radius:18px;">
          <div style="border-radius:12px;overflow:hidden;aspect-ratio:16/10;margin-bottom:1.25rem;">
            <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=700&auto=format&fit=crop&q=80" alt="Generative Light Sculpture" style="width:100%;height:100%;object-fit:cover;" />
          </div>
          <span class="vibe-badge" style="font-size:0.65rem;">GENERATIVE SHADER</span>
          <h3 style="font-size:1.25rem;font-weight:800;margin-top:0.4rem;">Chromatic Horizon</h3>
          <p style="color:#94a3b8;font-size:0.88rem;margin-top:0.4rem;line-height:1.6;">Multi-spectral lighting synthesis exploring mathematical color spaces and optical refraction.</p>
        </article>

        <article class="vibe-card hover-lift p-4" style="background:#0c0e17;border:1px solid rgba(255,255,255,0.08);border-radius:18px;">
          <div style="border-radius:12px;overflow:hidden;aspect-ratio:16/10;margin-bottom:1.25rem;">
            <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?w=700&auto=format&fit=crop&q=80" alt="Spatial Geometry" style="width:100%;height:100%;object-fit:cover;" />
          </div>
          <span class="vibe-badge" style="font-size:0.65rem;">SPATIAL 3D</span>
          <h3 style="font-size:1.25rem;font-weight:800;margin-top:0.4rem;">Aetherial Synthesis</h3>
          <p style="color:#94a3b8;font-size:0.88rem;margin-top:0.4rem;line-height:1.6;">Hardware-accelerated perspective matrix projecting volumetric particles across 3D planes.</p>
        </article>

        <article class="vibe-card hover-lift p-4" style="background:#0c0e17;border:1px solid rgba(255,255,255,0.08);border-radius:18px;">
          <div style="border-radius:12px;overflow:hidden;aspect-ratio:16/10;margin-bottom:1.25rem;">
            <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=700&auto=format&fit=crop&q=80" alt="Fluid Canvas" style="width:100%;height:100%;object-fit:cover;" />
          </div>
          <span class="vibe-badge" style="font-size:0.65rem;">FLUID DYNAMICS</span>
          <h3 style="font-size:1.25rem;font-weight:800;margin-top:0.4rem;">Quantum Drift</h3>
          <p style="color:#94a3b8;font-size:0.88rem;margin-top:0.4rem;line-height:1.6;">Pure CSS fluid mesh layers blended with hardware difference modes.</p>
        </article>
      </div>
    </section>

    <footer id="contact" style="text-align:center;padding:4rem 2rem;border-top:1px solid rgba(255,255,255,0.06);">
      <h2 style="font-size:2rem;font-weight:900;">Have an ambitious vision?</h2>
      <p style="color:#64748b;margin:0.5rem auto 1.5rem;max-width:440px;">Accepting commission proposals for 2026 digital exhibitions and spatial web projects.</p>
      <button class="vibe-btn hover-bounce" style="font-size:1rem;padding:0.85rem 2rem;">elena@vancestudio.design ↗</button>
    </footer>
  </main>

</body>
</html>`,

  retro: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alex's Cyber Realm 1999 — Unboilerplate</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@latest/dist/unboilerplate.min.css">
</head>
<body style="background:#000080;color:#ffff00;margin:0;padding:2rem 1rem;font-family:'Courier New',monospace;background-image:radial-gradient(#000055 15%, transparent 16%);background-size:16px 16px;">

  <div class="site-retro" style="max-width:760px;margin:0 auto;background:#c0c0c0;border:3px outset #fff;color:#000;box-shadow:8px 8px 0 rgba(0,0,0,0.6);">
    <header class="retro-header" style="background:linear-gradient(90deg,#000080,#1084d0);padding:1rem;color:#fff;text-align:center;">
      <h1 class="text-rainbow" style="font-size:clamp(1.5rem,5vw,2.5rem);margin:0;">~*~ Welcome to Alex's Web Oasis ~*~</h1>
      <div class="marquee" style="background:#000;color:#00ff00;padding:4px;margin-top:8px;font-size:0.8rem;">
        <span>★ BEST VIEWED IN 800x600 ★ ZERO JAVASCRIPT DETECTED ★ NETSCAPE 4.0 READY ★ SIGN MY GUESTBOOK ★</span>
      </div>
    </header>

    <nav class="retro-nav" style="padding:0.75rem;background:#808080;display:flex;gap:0.5rem;justify-content:center;flex-wrap:wrap;">
      <a href="#" class="btn-3d" style="font-size:0.85rem;padding:4px 14px;">Home</a>
      <a href="#" class="btn-3d" style="font-size:0.85rem;padding:4px 14px;">My Photos</a>
      <a href="#" class="btn-3d" style="font-size:0.85rem;padding:4px 14px;">Bookmarks</a>
      <a href="#" class="btn-3d" style="font-size:0.85rem;padding:4px 14px;">Guestbook</a>
    </nav>

    <main class="retro-main p-6" style="padding:1.5rem;">
      <div class="window-95" style="width:100%;margin-bottom:1.5rem;">
        <div class="window-titlebar">
          <span class="window-title">C:\\ABOUT_ME\\BIO.TXT</span>
          <div class="window-buttons">
            <button class="win-btn">_</button>
            <button class="win-btn">□</button>
            <button class="win-btn win-close">×</button>
          </div>
        </div>
        <div class="window-content p-4" style="background:#fff;color:#000;">
          <p style="font-size:0.95rem;line-height:1.6;">Hello surfer! Welcome to my personal homepage. I love 8-bit chip music, building websites with pure CSS, and 90s cyber aesthetics.</p>
          <div class="flex items-center gap-3 mt-3">
            <span class="blink blink--soft" style="color:#000080;font-weight:700;">STATUS: CODING AT 3:00 AM</span>
          </div>
        </div>
      </div>

      <!-- Winamp Display -->
      <div class="winamp-player" style="max-width:320px;margin:0 auto 1.5rem;">
        <div class="winamp-display"><span>1. Daft_Punk_Around_The_World.mp3</span></div>
        <div class="winamp-eq"><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div></div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;border-top:2px groove #fff;padding-top:1rem;">
        <div class="visitor-counter">
          <span style="color:#333;font-size:0.75rem;">HIT COUNTER:</span>
          <span class="counter-digits">004299</span>
        </div>
        <div>
          <span class="badge" style="background:#000;color:#00ff00;padding:4px 8px;font-size:0.75rem;border:1px solid #00ff00;">HANDCRAFTED HTML</span>
        </div>
      </div>
    </main>
