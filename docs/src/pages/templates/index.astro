</head>
<body style="background:#0d0e15;color:#fff;margin:0;padding:0;overflow-x:hidden;">

  <section class="vapor-sunset" style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:4rem 2rem;">
