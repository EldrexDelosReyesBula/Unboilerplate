---

<DocsLayout
  title="Component Library — Unboilerplate"
  description="Production-ready pure CSS building blocks. Buttons, cards, 3D elements, retro marquees, and dynamic particles with zero JavaScript."
  activePage="components"
  tocItems={tocItems}
>

  <!-- SIDEBAR -->
  <div slot="sidebar">
    <p class="sidebar-group-title">Components</p>
    <div class="sidebar-links">
      <a href="#overview"  class="sidebar-link active">Overview</a>
      <a href="#buttons"   class="sidebar-link">Buttons &amp; Controls</a>
      <a href="#cards"     class="sidebar-link">Cards &amp; Surfaces</a>
      <a href="#3d"        class="sidebar-link">3D Spatial</a>
      <a href="#retro"     class="sidebar-link">Retro &amp; Vintage</a>
      <a href="#particles" class="sidebar-link">Motion &amp; FX</a>
      <a href="#badges"    class="sidebar-link">Badges &amp; Shaders</a>
    </div>

    <p class="sidebar-group-title" style="margin-top:1.5rem;">Explore</p>
    <div class="sidebar-links">
      <a href="/"           class="sidebar-link">Get Started</a>
      <a href="/playground" class="sidebar-link" style="color:#00f2fe;font-weight:700;">Playground</a>
      <a href="/templates"  class="sidebar-link">Templates</a>
      <a href="/docs"       class="sidebar-link">API Docs</a>
      <a href="/cheatsheet" class="sidebar-link">Class Cheatsheet</a>
      <a href="/showcase"   class="sidebar-link">Showcase</a>
    </div>

    <p class="sidebar-group-title" style="margin-top:1.5rem;">Quick Links</p>
    <div class="sidebar-links">
      <a href="/docs" class="sidebar-link">API Reference</a>
      <a href="https://github.com/EldrexDelosReyesBula/unboilerplate" class="sidebar-link" target="_blank">GitHub Repository</a>
    </div>
  </div>

  <!-- TOC CARD -->
  <div slot="toc-card" style="margin-top:2rem;padding:1rem;background:rgba(255,0,122,0.06);border:1px solid rgba(255,0,122,0.2);border-radius:12px;">
    <p style="font-size:0.78rem;font-weight:700;color:#fff;margin-bottom:0.5rem;">Zero JavaScript</p>
    <p style="font-size:0.75rem;color:#64748b;line-height:1.5;">Every component runs purely on standard HTML5 and modern CSS3 specification.</p>
    <a href="/cheatsheet" style="display:block;margin-top:0.75rem;font-size:0.78rem;color:#ff007a;text-decoration:none;font-weight:700;">Explore All Classes →</a>
  </div>

  <!-- MAIN CONTENT -->
  <div id="overview">
    <div class="docs-breadcrumb">
      <a href="/" style="color:#64748b;text-decoration:none;">Unboilerplate</a>
      <span>›</span>
      <span>Components</span>
    </div>

    <h1 class="docs-page-title text-gradient --ocean">Component Library</h1>
    <p class="docs-lead">Pre-built interactive UI elements built entirely in pure CSS. Copy the markup and start building.</p>

    <div class="how-to-box">
      <strong>How to use:</strong> Each component is a single HTML class. Add it to any element in your markup. Pair with utility classes (<code>.p-6</code>, <code>.stack</code>, <code>.flex</code>) for spacing and layout. Override CSS variables inline for custom colors.
    </div>

    <!-- Filter Strip -->
    <div class="filter-strip" id="filter-strip" style="margin-top:1.5rem;">
      <button class="filter-btn active" data-filter="all">All Components</button>
      <button class="filter-btn" data-filter="buttons">Buttons &amp; Controls</button>
      <button class="filter-btn" data-filter="cards">Cards &amp; Surfaces</button>
      <button class="filter-btn" data-filter="3d">3D Spatial</button>
      <button class="filter-btn" data-filter="retro">Retro</button>
      <button class="filter-btn" data-filter="particles">Motion &amp; FX</button>
      <button class="filter-btn" data-filter="badges">Badges &amp; Shaders</button>
    </div>
  </div>


  <!-- Sections per category with How-To callouts -->
  {(['buttons','cards','3d','retro','particles','badges'] as const).map(cat => (
    <div>
      <hr class="section-divider" id={cat} />
      <div class="how-to-box" style={`margin-bottom:1.25rem; ${cat === '3d' ? 'border-color:rgba(0,242,254,0.3);background:rgba(0,242,254,0.06);' : cat === 'retro' ? 'border-color:rgba(255,200,0,0.3);background:rgba(255,200,0,0.04);' : cat === 'badges' ? 'border-color:rgba(255,0,127,0.3);background:rgba(255,0,127,0.04);' : ''}`}>
        {cat === 'buttons' && (<><strong>Buttons &amp; Controls</strong> — Drop a button class on any <code>&lt;button&gt;</code> element. The <code>:active</code> press state and hover lift are built-in. No extra markup needed.</>)}
        {cat === 'cards' && (<><strong>Cards &amp; Surfaces</strong> — Apply to any <code>&lt;div&gt;</code> container. Combine with <code>.p-6</code> for padding, <code>.stack</code> for internal layout. Override <code>--card-bg</code> to change background.</>)}
        {cat === '3d' && (<><strong>3D Spatial</strong> — These use <code>transform-style: preserve-3d</code> and GPU compositing. Hover and click interactions are purely CSS-driven with hardware matrices.</>)}
        {cat === 'retro' && (<><strong>Retro / Time Machine</strong> — Drop the class on a container and add the correct child elements shown in the snippets. Mix with <code>.marquee--pause-hover</code> to pause on hover.</>)}
        {cat === 'particles' && (<><strong>Motion &amp; FX</strong> — Add <code>.particle</code> with a motion modifier (<code>--float-slow</code>, <code>--spin</code>, <code>--orbit</code>) inside a <code>.particles-3d</code> container, or <code>.text-animate.--typewriter</code> on headings.</>)}
        {cat === 'badges' && (<><strong>Badges, Chips &amp; Typography Shaders</strong> — Add tag chips (<code>.vibe-badge</code>, <code>.vibe-badge--neon</code>) or headline text shaders (<code>.text-gradient</code>, <code>.text-fire</code>, <code>.text-ice</code>) for vibrant accents.</>)}
      </div>
      <div class="comp-grid">
        {components.filter(c => c.category === cat).map(comp => (
          <div class="comp-card" data-category={comp.category}>
            <div>
              <div class="comp-preview-box" set:html={comp.preview} />
              <p class="comp-name">{comp.name}</p>
              <p class="comp-desc">{comp.desc}</p>
            </div>
            <button
              class="vibe-btn --sm copy-btn"
              data-snippet={comp.snippet}
              style="margin-top:1rem;"
            >
              Copy HTML
            </button>
          </div>
        ))}
      </div>
    </div>
  ))}


  <hr class="section-divider" />
  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
    <a href="/playground" class="vibe-btn hover-bounce">Edit in Playground</a>
    <a href="/templates" class="pill-tab">Starter Templates →</a>
    <a href="/cheatsheet" class="pill-tab">Class Cheatsheet →</a>
  </div>

</DocsLayout>

<div id="toast" style="display:none;"></div>

<script>
  // Filter
  const strip = document.getElementById('filter-strip')!;
  strip.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;
    strip.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter!;
    document.querySelectorAll<HTMLElement>('.comp-card').forEach(card => {
      card.style.display = (f === 'all' || card.dataset.category === f) ? '' : 'none';
    });
  });

  // Copy
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.snippet!).then(() => {
        (window as any).ubToast?.('Copied snippet to clipboard');
      });
    });
  });
</script>

<style>
  .section-divider { border: none; border-top: 1px solid rgba(255,255,255,0.07); margin: 2.5rem 0; }
  .how-to-box {
    background: rgba(0,242,254,0.04);
    border: 1px solid rgba(0,242,254,0.18);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.6;
  }
  .how-to-box strong { color: #00f2fe; }
  .how-to-box code { color: #00f2fe; background: rgba(0,242,254,0.08); padding: 1px 5px; border-radius: 4px; font-size: 0.83em; }
  .comp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 1.25rem; }
  .comp-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
  }
  .comp-card:hover {
    border-color: rgba(0,242,254,0.35);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
  .comp-preview-box {
    background: radial-gradient(circle at 50% 50%, #0d0f1a 0%, #06070a 100%);
    border-radius: 12px;
    padding: 1.25rem 1rem;
    min-height: 135px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    perspective: 900px;
  }
  .comp-name { font-weight: 800; font-size: 0.92rem; color: #f3f4f8; }
  .comp-desc { font-size: 0.82rem; color: #94a3b8; line-height: 1.5; margin-top: 0.35rem; }
  .filter-strip { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filter-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: #94a3b8;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }
  .filter-btn:hover, .filter-btn.active {
    background: rgba(0,242,254,0.12);
    border-color: rgba(0,242,254,0.4);
    color: #00f2fe;
  }
</style>

