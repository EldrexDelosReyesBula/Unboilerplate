---
// Unboilerplate Playground — Pure CSS Creative IDE in Astro
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Playground — Unboilerplate</title>
  <meta name="description" content="Pure CSS creative workspace. Interactive presets, component pickers, live responsive viewport, and zero build step." />
  <link rel="icon" type="image/png" href="/assets/unboilerplate-logo.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet" />
  
  <!-- Monaco Editor Loader -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #06070a;
      color: #f3f4f8;
      font-family: var(--ub-font-family-sans, 'Plus Jakarta Sans', sans-serif);
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Top Studio Header */
    .studio-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.55rem 1.25rem;
      background: #0b0d14;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 100;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .brand-logo-img {
      width: 26px;
      height: 26px;
      object-fit: contain;
      border-radius: 6px;
    }

    .brand-title {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .brand-badge {
      background: rgba(0, 242, 254, 0.12);
      color: #00f2fe;
      border: 1px solid rgba(0, 242, 254, 0.3);
      font-size: 0.65rem;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Studio Controls & Dropdowns */
    .studio-controls {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .control-group {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.2rem 0.5rem;
      border-radius: 8px;
    }

    .control-label {
      font-size: 0.7rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .studio-select {
      background: #111420;
      color: #f3f4f8;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      padding: 0.3rem 0.6rem;
      font-size: 0.76rem;
      font-weight: 600;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .studio-select:hover, .studio-select:focus {
      border-color: rgba(0, 242, 254, 0.5);
      background: #161a29;
    }

    .studio-select optgroup {
      background: #0d0f17;
      color: #94a3b8;
      font-weight: 700;
    }

    .studio-select option {
      background: #111420;
      color: #f3f4f8;
      font-weight: 500;
    }

    .action-btn {
      padding: 0.35rem 0.85rem;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      text-decoration: none;
      font-family: inherit;
      border: none;
      white-space: nowrap;
    }

    .action-btn--primary {
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
      color: #06070a;
      box-shadow: 0 4px 14px rgba(0, 242, 254, 0.3);
    }
    .action-btn--primary:hover {
      box-shadow: 0 6px 20px rgba(0, 242, 254, 0.5);
      transform: translateY(-1px);
    }

    .action-btn--subtle {
      background: rgba(255, 255, 255, 0.05);
      color: #f3f4f8;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .action-btn--subtle:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* Mobile Pane Switcher */
    .mobile-pane-switcher {
      display: none;
      background: #0b0d14;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.35rem 1rem;
      gap: 0.5rem;
    }

    .mobile-tab-btn {
      flex: 1;
      padding: 0.4rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      color: #94a3b8;
      cursor: pointer;
    }

    .mobile-tab-btn.active {
      background: rgba(0, 242, 254, 0.12);
      color: #00f2fe;
      border-color: rgba(0, 242, 254, 0.35);
    }

    /* Studio Workspace Split Pane */
    .studio-layout {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
      position: relative;
    }

    @media (max-width: 900px) {
      .mobile-pane-switcher {
        display: flex;
      }
      .studio-layout {
        grid-template-columns: 1fr;
      }
      .editor-pane.mobile-hidden, .preview-pane.mobile-hidden {
        display: none !important;
      }
    }

    .editor-pane {
      display: flex;
      flex-direction: column;
      background: #08090f;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
      position: relative;
    }

    .pane-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.45rem 1rem;
      background: #0e111a;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 0.75rem;
      font-weight: 700;
      color: #94a3b8;
    }

    .pane-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }
    .status-dot--cyan { background: #00f2fe; box-shadow: 0 0 8px #00f2fe; }
    .status-dot--green { background: #10b981; box-shadow: 0 0 8px #10b981; }

    #monaco-editor-box {
      flex: 1;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .fallback-textarea {
      width: 100%;
      height: 100%;
      background: #08090f;
      color: #00f2fe;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      padding: 1rem;
      border: none;
      resize: none;
      outline: none;
      line-height: 1.6;
    }

    .preview-pane {
      display: flex;
      flex-direction: column;
      background: #06070a;
      overflow: hidden;
      position: relative;
    }

    .preview-stage {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 1.5rem;
      transition: background 0.3s ease, color 0.3s ease;
      width: 100%;
      height: 100%;
      background-color: var(--ub-bg, #06070a);
      color: var(--ub-text, #f3f4f8);
      display: block;
    }

    .toast-popup {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #00f2fe;
      color: #06070a;
      padding: 10px 20px;
      border-radius: 100px;
      font-weight: 700;
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 242, 254, 0.4);
      z-index: 10000;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .toast-popup.is-visible {
      transform: translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body>

  <!-- TOP HEADER -->
  <header class="studio-header">
    <div class="brand-group">
      <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 0.65rem;">
        <img src="/assets/unboilerplate-logo.png" alt="Unboilerplate Logo" class="brand-logo-img" />
        <span class="brand-title">Playground</span>
      </a>
    </div>

    <!-- Clean Central Controls Strip -->
    <div class="studio-controls">
      <!-- 1. Templates Dropdown -->
      <div class="control-group">
        <label class="control-label" for="select-preset">Template:</label>
        <select class="studio-select" id="select-preset">
          <option value="helloWorld" selected>✨ Hello World (Fresh Start)</option>
          <option value="artistPortfolio">🎨 Creative Artist Portfolio</option>
          <option value="saas">🚀 Modern AI SaaS Platform</option>
          <option value="bento">🍱 Spatial Bento Grid Portfolio</option>
          <option value="cleanGirl">🌿 Clean Girl Minimal</option>
          <option value="cyberDashboard">⚡ Cyberpunk HUD Dashboard</option>
          <option value="neoBrutal">💥 Neo-Brutalism Poster & Zine</option>
          <option value="literaryJournal">📖 Dark Academia Journal</option>
          <option value="coffee">☕ Artisanal Coffee Roastery</option>
          <option value="luxury">💎 Luxury Fashion Lookbook</option>
          <option value="indieGame">👾 16-Bit Indie Game Showcase</option>
          <option value="retro1999">🕹️ 1999 Personal Homepage</option>
          <option value="polaroidStack">📸 Stacked Polaroid Photos</option>
          <option value="cube3d">🎲 3D Rotating Photo Cube</option>
          <option value="vaporwave">🌴 Vaporwave Sunset Canvas</option>
          <option value="book3d">📖 3D Interactive Book</option>
          <option value="canvasLayers">🖌️ Photoshop Canvas Layers</option>
          <option value="carousel3d">🎡 3D Orbital Carousel</option>
          <option value="particles3d">🌌 3D Celestial Particles</option>
          <option value="win95">🪟 Windows 95 Dialog Window</option>
          <option value="crtScreen">📺 CRT Monitor Terminal</option>
        </select>
      </div>

      <!-- 2. Snippets Dropdown -->
      <div class="control-group">
        <label class="control-label" for="select-snippet">Snippet:</label>
        <select class="studio-select" id="select-snippet">
          <option value="" disabled selected>Insert snippet...</option>
          <optgroup label="Physical & 3D">
            <option value="cardFlip">3D 180° Flip Card</option>
            <option value="book">3D Storybook Interactive</option>
            <option value="fanStack">3D Fan Stack Deck</option>
            <option value="cube">Rotating 3D Cube</option>
            <option value="btn3d">Physical 3D Spring Button</option>
            <option value="carousel">3D Orbital Ring</option>
          </optgroup>
          <optgroup label="Cards & Containers">
            <option value="vibeCard">Glassmorphic Frosted Card</option>
            <option value="conicGlow">360° Conic Rainbow Card</option>
            <option value="priceCard">SaaS Pricing Tier Card</option>
            <option value="brutalCard">Neo-Brutalist Bold Card</option>
            <option value="woodCard">Mahogany Grain Card</option>
          </optgroup>
          <optgroup label="Typography & Glows">
            <option value="neonText">Cyberpunk Neon Text</option>
            <option value="textGradient">Vibrant Text Gradient</option>
            <option value="typewriter">Pure CSS Typewriter</option>
            <option value="crtGlow">Phosphor Terminal Glow</option>
          </optgroup>
          <optgroup label="Layouts & Spacing">
            <option value="vibeGrid">Auto-Fill Responsive Grid</option>
            <option value="flexRow">Flexbox Centered Row</option>
            <option value="boxmodel">Box Model Visualizer</option>
            <option value="marquee">Smooth Marquee Banner</option>
            <option value="badges">Status Badge Chips</option>
          </optgroup>
          <optgroup label="Retro & Nostalgia">
            <option value="win95">Windows 95 Window Frame</option>
            <option value="counter">90s Web Hit Counter</option>
            <option value="pixelBtn">8-Bit Retro Button</option>
          </optgroup>
        </select>
      </div>

      <!-- 3. Aesthetic Theme Dropdown -->
      <div class="control-group">
        <label class="control-label" for="select-theme">Theme:</label>
        <select class="studio-select" id="select-theme">
          <option value="default">Default Dark</option>
          <option value="theme-cyberpunk">Cyberpunk Neon</option>
          <option value="theme-cottagecore">Cottagecore Botanical</option>
          <option value="theme-y2k">Y2K Gloss Hologram</option>
          <option value="theme-dark-academia">Dark Academia Classical</option>
          <option value="theme-clean-girl">Clean Girl Minimal</option>
        </select>
      </div>

      <!-- 4. CDN Version Dropdown -->
      <div class="control-group">
        <label class="control-label" for="select-cdn-version">CDN:</label>
        <select class="studio-select" id="select-cdn-version" title="CDN Version in copied code">
          <option value="latest">@latest</option>
          <option value="1.0.0">@1.0.0</option>
        </select>
      </div>
    </div>

    <!-- Top Action Buttons -->
    <div class="studio-controls">
      <button class="action-btn action-btn--subtle" id="btn-format" style="padding: 0.35rem 0.75rem; font-size: 0.78rem;">
        Format
      </button>
      <button class="action-btn action-btn--primary" id="btn-copy">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        Copy Code
      </button>
    </div>
  </header>

  <!-- Mobile View Switcher (Visible on mobile/tablet screens) -->
  <div class="mobile-pane-switcher" id="mobile-switcher">
    <button class="mobile-tab-btn active" id="tab-code">💻 Source Code</button>
    <button class="mobile-tab-btn" id="tab-preview">👁 Live Stage</button>
  </div>

  <!-- MAIN WORKSPACE -->
  <main class="studio-layout">
    
    <!-- Code Editor Column -->
    <section class="editor-pane">
      <div class="pane-toolbar">
        <div class="pane-title">
          <span class="status-dot status-dot--cyan"></span>
          <span>Source Code</span>
        </div>
      </div>
      <div id="monaco-editor-box">
        <textarea id="fallback-editor" class="fallback-textarea" spellcheck="false"></textarea>
      </div>
    </section>

    <!-- Live Stage Preview Column -->
    <section class="preview-pane">
      <div class="pane-toolbar">
        <div class="pane-title">
          <span class="status-dot status-dot--green"></span>
          <span>Live Stage</span>
        </div>
      </div>

      <div id="preview-stage" class="preview-stage"></div>
    </section>

  </main>

  <div id="toast-popup" class="toast-popup">Copied to clipboard</div>

  <script is:inline>
    const ideTemplates = {
      helloWorld: `<!-- ✨ Welcome to Unboilerplate Playground! ✨
     Simple, friendly, pure CSS. Edit anything below to make it your own! -->
<div class="flex center" style="min-height: 75vh; width: 100%;">
  <div class="vibe-card p-8 text-center" style="max-width: 520px; width: 100%; border-radius: 24px;">
    <span class="vibe-badge vibe-badge--neon mb-3">PURE CSS STARTER</span>
    <h1 class="text-gradient font-bold" style="font-size: clamp(2rem, 5vw, 2.8rem); margin: 0.5rem 0;">
      Hello, World! ✨
    </h1>
    <p style="color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 1.5rem;">
      Welcome to your personal CSS canvas. No complex setup, no JavaScript, and no build tools. Just pure creativity.
    </p>
    <div class="flex justify-center gap-3 flex-wrap">
      <button class="vibe-btn hover-bounce">Click Me 🚀</button>
      <button class="pill-tab hover-lift">Get Started</button>
    </div>
  </div>
</div>`,

      artistPortfolio: `<!-- Elena Vance Studio — Creative Artist Portfolio -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Elena Vance — Creative Technologist & Digital Artist</title>
