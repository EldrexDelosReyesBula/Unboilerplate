    let monacoEditor = null;
    const fallbackEditor = document.getElementById('fallback-editor');
    const previewStage = document.getElementById('preview-stage');

    function updatePreview(code) {
      if (!previewStage) return;
      let renderCode = code;

      const bodyMatch = code.match(/<body([^>]*)>([\s\S]*)<\/body>/i);
      if (bodyMatch) {
        const bodyAttrs = bodyMatch[1] || '';
        renderCode = bodyMatch[2];

        // Extract class from template body tag
        const classMatch = bodyAttrs.match(/class=["']([^"']*)["']/i);
        const styleMatch = bodyAttrs.match(/style=["']([^"']*)["']/i);

        previewStage.className = 'preview-stage';
        if (classMatch && classMatch[1]) {
          previewStage.className = `preview-stage ${classMatch[1]}`;
        }
        
        if (styleMatch && styleMatch[1]) {
          previewStage.style.cssText = styleMatch[1];
        } else {
          previewStage.style.cssText = '';
        }
      } else {
        previewStage.style.cssText = '';
        // For standalone snippets, apply user-selected theme from dropdown
        const themeSelect = document.getElementById('select-theme');
        const currentTheme = themeSelect ? themeSelect.value : 'default';
        previewStage.className = 'preview-stage';
        if (currentTheme !== 'default') {
          previewStage.classList.add(currentTheme);
        }
      }
      previewStage.innerHTML = renderCode;
    }

    function initMonaco() {
      try { localStorage.removeItem('ub_load_tpl'); } catch(e) {}

      const urlParams = new URLSearchParams(window.location.search);
      const tplParam = urlParams.get('template') || urlParams.get('preset');
      
      const aliasMap = {
        'artist': 'artistPortfolio',
        'dark-academia': 'literaryJournal',
        'cyberpunk': 'cyberDashboard',
        'clean-girl': 'cleanGirl',
        'polaroid': 'polaroidStack',
        'retro': 'retro1999',
        'cube': 'cube3d',
        'neo-brutalist': 'neoBrutal',
        'indie-game': 'indieGame',
      };

      let initialTemplateKey = 'helloWorld';
      if (tplParam) {
        initialTemplateKey = aliasMap[tplParam] || tplParam;
      }

      const presetSelect = document.getElementById('select-preset');
      if (presetSelect && ideTemplates[initialTemplateKey]) {
        presetSelect.value = initialTemplateKey;
      }

      const initialCode = ideTemplates[initialTemplateKey] || ideTemplates.helloWorld;

      if (window.require) {
        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
        require(['vs/editor/editor.main'], function () {
          fallbackEditor.style.display = 'none';
          monacoEditor = monaco.editor.create(document.getElementById('monaco-editor-box'), {
            value: initialCode,
            language: 'html',
            theme: 'vs-dark',
            automaticLayout: true,
            fontSize: 13,
            fontFamily: "'JetBrains Mono', Consolas, monospace",
            minimap: { enabled: false },
            lineNumbers: 'on',
            scrollBeyondLastLine: false,
            padding: { top: 12, bottom: 12 },
            lineHeight: 20
          });

          monacoEditor.onDidChangeModelContent(() => {
            updatePreview(monacoEditor.getValue());
          });

          updatePreview(initialCode);
        });
      } else {
        fallbackEditor.value = initialCode;
        fallbackEditor.addEventListener('input', () => updatePreview(fallbackEditor.value));
        updatePreview(initialCode);
      }
    }

    function setCode(code) {
      if (monacoEditor) {
        monacoEditor.setValue(code);
      } else {
        fallbackEditor.value = code;
      }
      updatePreview(code);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast-popup');
      toast.textContent = msg;
      toast.classList.add('is-visible');
      setTimeout(() => toast.classList.remove('is-visible'), 2200);
    }

    // Mobile Tab Switcher
    const tabCode = document.getElementById('tab-code');
    const tabPreview = document.getElementById('tab-preview');
    const editorPane = document.querySelector('.editor-pane');
    const previewPane = document.querySelector('.preview-pane');

    function setMobileTab(tab) {
      if (!tabCode || !tabPreview) return;
      if (tab === 'code') {
        tabCode.classList.add('active');
        tabPreview.classList.remove('active');
        editorPane?.classList.remove('mobile-hidden');
        previewPane?.classList.add('mobile-hidden');
      } else {
        tabPreview.classList.add('active');
        tabCode.classList.remove('active');
        previewPane?.classList.remove('mobile-hidden');
        editorPane?.classList.add('mobile-hidden');
      }
    }

    tabCode?.addEventListener('click', () => setMobileTab('code'));
    tabPreview?.addEventListener('click', () => setMobileTab('preview'));

    if (window.innerWidth < 900) {
      setMobileTab('code');
    }

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) {
        editorPane?.classList.remove('mobile-hidden');
        previewPane?.classList.remove('mobile-hidden');
      } else {
        const activeTab = tabCode?.classList.contains('active') ? 'code' : 'preview';
        setMobileTab(activeTab);
      }
    });

    // 1. Preset Dropdown Handler
    document.getElementById('select-preset')?.addEventListener('change', (e) => {
      const key = e.target.value;
      if (ideTemplates[key]) {
        const themeSelect = document.getElementById('select-theme');
        if (themeSelect) themeSelect.value = 'default';
        setCode(ideTemplates[key]);
        showToast(`Loaded ${e.target.options[e.target.selectedIndex].text}`);
      }
    });

    // 2. Component Snippet Dropdown Handler
    document.getElementById('select-snippet')?.addEventListener('change', (e) => {
      const key = e.target.value;
      if (snippetLibrary[key]) {
        setCode(snippetLibrary[key]);
        showToast(`Inserted ${e.target.options[e.target.selectedIndex].text}`);
      }
    });

    // 3. Theme Dropdown Handler
    document.getElementById('select-theme')?.addEventListener('change', (e) => {
      const currentCode = monacoEditor ? monacoEditor.getValue() : fallbackEditor.value;
      updatePreview(currentCode);
      showToast(`Applied ${e.target.options[e.target.selectedIndex].text}`);
    });

    // Action: Format Code
    document.getElementById('btn-format')?.addEventListener('click', () => {
      try {
        if (monacoEditor) {
          const action = monacoEditor.getAction('editor.action.formatDocument');
          if (action) {
            action.run().catch(() => {});
          }
        }
        showToast('Code formatted ✨');
      } catch (e) {
        showToast('Code formatted ✨');
      }
    });

    // Action: Copy Code (with CDN and selectable @latest / @1.0.0 version)
    document.getElementById('btn-copy')?.addEventListener('click', () => {
      const code = monacoEditor ? monacoEditor.getValue() : fallbackEditor.value;
      const cdnVersion = document.getElementById('select-cdn-version')?.value || 'latest';
      
      // If code is already a complete standalone HTML document, copy it directly with normalized CDN
      if (code.includes('<!DOCTYPE html>') || code.includes('<html')) {
        const updatedCode = code.replace(
          /unboilerplate@(latest|[0-9\.]+)\/dist\/unboilerplate\.min\.css/g,
          `unboilerplate@${cdnVersion}/dist/unboilerplate.min.css`
        );
        navigator.clipboard.writeText(updatedCode).then(() => {
          showToast(`Copied complete HTML with CDN @${cdnVersion}!`);
        });
        return;
      }

      // If snippet only, wrap in standalone boilerplate with active theme
      const themeSelect = document.getElementById('select-theme');
      const currentTheme = themeSelect ? themeSelect.value : 'default';
      const themeClassAttr = currentTheme !== 'default' ? ` class="${currentTheme}"` : '';

      const fullHTML = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unboilerplate Project</title>
  <!-- Unboilerplate Pure CSS CDN (use @latest for auto-updates, or @1.0.0 for a locked version) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eldrex/unboilerplate@${cdnVersion}/dist/unboilerplate.min.css">
</head>
<body${themeClassAttr} style="min-height: 100vh; margin: 0; padding: 2rem; display: flex; align-items: center; justify-content: center;">
${code}
</body>
</html>`;

      navigator.clipboard.writeText(fullHTML).then(() => {
        showToast(`Copied full HTML with CDN @${cdnVersion}!`);
      });
    });

    window.addEventListener('DOMContentLoaded', initMonaco);
  </script>
</body>
</html>
