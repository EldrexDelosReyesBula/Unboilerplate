---
import DocsLayout from '../layouts/DocsLayout.astro';

const tocItems: Array<{ id: string; label: string }> = [];
---

<DocsLayout
  title="UNBOILERPLATE — Pure CSS Creative Engine"
  description="Pure CSS. Zero JavaScript runtime. Hardware-accelerated 3D effects, Photoshop-like canvas layers, retro systems, and modular design tokens."
  activePage="home"
  tocItems={tocItems}
>

  <!-- SIDEBAR -->
  <div slot="sidebar">
    <p class="sidebar-group-title">Manifesto &amp; Guide</p>
    <div class="sidebar-links">
      <a href="/philosophy" class="sidebar-link" style="color:#00f2fe;font-weight:700;">The Complete Story ↗</a>
      <a href="#hero" class="sidebar-link active">The Philosophy</a>
      <a href="#time-machine" class="sidebar-link">The Time Machine</a>
      <a href="#dimension-3d" class="sidebar-link">3D Dimensions &amp; Books</a>
      <a href="#design-freedom" class="sidebar-link">Total Design Freedom</a>
      <a href="#creative-universe" class="sidebar-link">Creative Universe</a>
      <a href="#art-studio" class="sidebar-link">Design Movements</a>
      <a href="#love-letter" class="sidebar-link">Manifesto Note</a>
      <a href="#credits" class="sidebar-link">Credits &amp; Artwork</a>
    </div>

    <p class="sidebar-group-title" style="margin-top:1.5rem;">Quick Links</p>
    <div class="sidebar-links">
      <a href="/playground" class="sidebar-link">Playground</a>
      <a href="/cheatsheet" class="sidebar-link">Class Cheatsheet</a>
      <a href="/components" class="sidebar-link">Component Library</a>
      <a href="/templates" class="sidebar-link">Starter Templates</a>
      <a href="/docs" class="sidebar-link">Full API Reference</a>
    </div>
  </div>

  <!-- TOC CARD -->
  <div slot="toc-card" style="margin-top:2rem;padding:1rem;background:rgba(0,242,254,0.05);border:1px solid rgba(0,242,254,0.15);border-radius:12px;">
    <p style="font-size:0.78rem;font-weight:700;color:#fff;margin-bottom:0.5rem;">Instant CDN Integration</p>
    <p style="font-size:0.75rem;color:#64748b;line-height:1.5;">Drop one stylesheet link into your HTML head to enable the entire CSS design engine.</p>
    <button class="vibe-btn --sm" style="width:100%;margin-top:0.75rem;font-size:0.78rem;" id="copy-cdn-btn">Copy CDN Tag</button>
  </div>

  <!-- ── HERO MANIFESTO ─────────────────────────────────────────── -->
  <section id="hero" class="vibe-hero text-center hero-with-gif" style="position:relative; overflow:hidden; border-radius:24px; margin-bottom:2.5rem; padding: clamp(4.5rem, 10vw, 7.5rem) 1.5rem clamp(3.5rem, 8vw, 6rem); border:1px solid rgba(255,255,255,0.09); box-shadow: 0 25px 70px rgba(0,0,0,0.7);">
    <!-- Animated GIF Backdrop with Dark Overlay Vignette -->
    <div style="position:absolute; inset:0; background: url('/assets/hero.gif') center/cover no-repeat; filter: brightness(0.6) saturate(1.25); transform: scale(1.02); z-index:1;"></div>
    <div style="position:absolute; inset:0; background: radial-gradient(circle at center, rgba(6,7,10,0.5) 0%, rgba(6,7,10,0.92) 85%), linear-gradient(180deg, rgba(6,7,10,0.3) 0%, #06070a 100%); z-index:2;"></div>

    <div style="position:relative; z-index:10; max-width:820px; margin:0 auto;">
      <span class="section-eyebrow" style="margin-bottom:1.25rem; color:#00f2fe; background:rgba(0,242,254,0.12); border-color:rgba(0,242,254,0.35); display:inline-block;">✦ PURE CSS CREATIVE ENGINE</span>
      <h1 class="text-gradient" style="font-size: clamp(2.8rem, 9vw, 5.5rem); line-height: 1.02; font-weight: 900; letter-spacing: -0.04em;">
        CSS is boring.<br />Your designs shouldn't be.
      </h1>
      <p style="font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 580px; margin: 1.5rem auto 2.25rem; color: #e2e8f0; line-height: 1.7; text-shadow: 0 2px 12px rgba(0,0,0,0.9);">
        Rich visual defaults. Zero config. No build gymnastics.<br />Pure creative freedom &mdash; on tap.
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:0.85rem; justify-content:center; align-items:center;">
        <a href="/playground" class="vibe-btn hover-bounce" style="font-size:1rem; padding:0.8rem 1.85rem;">Launch Playground →</a>
        <a href="#time-machine" class="btn-3d btn-3d--cyan" style="font-size:0.95rem; padding:0.65rem 1.6rem;">Time Machine ↓</a>
      </div>
    </div>
  </section>

  <!-- ── THE TIME MACHINE ───────────────────────────────────────── -->
  <hr class="section-divider" id="time-machine" />
  <section class="stack gap-5">
    <div class="section-header-row" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
      <div class="section-header">
        <span class="section-eyebrow">🕹 Retro Systems</span>
        <h2 class="section-title">The Time Machine</h2>
        <p class="section-sub">Bringing back the personality of the early web — now GPU-accelerated.</p>
      </div>
      <a href="/playground" class="vibe-badge vibe-badge--sunset" style="flex-shrink:0;">Open in Playground →</a>
    </div>

    <!-- Modern Marquee Banner -->
    <div class="marquee marquee--neon marquee--pause-hover" style="background: #000; border: 1px solid rgba(0,242,254,0.3); padding:0.75rem; border-radius:12px;">
      <span style="color: #00f2fe; font-weight: 700; font-size: clamp(0.8rem, 2vw, 1rem);">
        ★ UNBOILERPLATE TIME MACHINE: GPU MARQUEE • PAUSES ON HOVER • NO MATH • OLD SCHOOL COOL • VISITORS WELCOME ★
      </span>
    </div>

    <div class="vibe-grid">
      <!-- WINDOWS 95 -->
      <div class="window-95 stack justify-between" style="padding:1.25rem;">
        <div class="window-titlebar">
          <span class="window-title">NETSCAPE_1995.EXE</span>
          <div class="window-buttons">
            <button class="win-btn">_</button>
            <button class="win-btn">□</button>
            <button class="win-btn win-close">×</button>
          </div>
        </div>
        <div class="window-content stack gap-2" style="padding:1rem 0;">
          <span class="blink blink--neon" style="color: #000080; font-weight: 800;">★ BEST VIEWED IN NETSCAPE ★</span>
          <p style="font-size: 0.88rem; color:#0f172a;">Pristine beveled Windows 95 UI with realistic active press feedback.</p>
          <div class="visitor-counter mt-2">
            <span style="color: #aaa; font-size: 0.75rem;">VISITORS:</span>
            <span class="counter-digits">004299</span>
          </div>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <small style="color: #555;">.window-95</small>
          <button class="win-btn" style="padding: 2px 8px; font-weight: 700;">OK</button>
        </div>
      </div>

      <!-- CRT MONITOR -->
      <div class="crt-screen crt-scanlines crt-flicker crt--green p-6 stack justify-between">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span>[TERMINAL_V1]</span>
            <span class="blink">● ONLINE</span>
          </div>
          <p class="crt-glow" style="font-size: 0.9rem; line-height: 1.5; margin-top:0.75rem;">
            &gt; Phosphor scanline simulation on GPU.<br>
            &gt; Zero boilerplate detected.<br>
            &gt; Aesthetic index: 100%
          </p>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem;">
          <small>.crt-screen</small>
          <button class="btn-8bit" style="font-size: 0.7rem; padding: 4px 8px;">EXECUTE</button>
        </div>
      </div>

      <!-- WINAMP PLAYER -->
      <div class="winamp-player stack justify-between">
        <div class="winamp-display">
          <span>1. Unboilerplate - Symphony of Vibes.mp3</span>
        </div>
        <div class="winamp-eq">
          <div class="eq-bar"></div>
          <div class="eq-bar"></div>
          <div class="eq-bar"></div>
          <div class="eq-bar"></div>
          <div class="eq-bar"></div>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.5rem;">
          <div style="display:flex; gap:4px;">
            <button class="pill-tab --sm">⏮</button>
            <button class="pill-tab --sm" style="background: #00ff00; color: #000; font-weight: 900;">▶</button>
            <button class="pill-tab --sm">⏹</button>
            <button class="pill-tab --sm">⏭</button>
          </div>
          <span class="counter-digits" style="font-size: 0.75rem;">03:42</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3D DIMENSIONS ──────────────────────────────────────────── -->
  <hr class="section-divider" id="dimension-3d" />
  <section class="stack gap-4">
    <div class="section-header-row" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
      <div class="section-header">
        <span class="section-eyebrow" style="color:#a78bfa; background:rgba(167,139,250,0.1); border-color:rgba(167,139,250,0.25);">🎲 3D Spatial CSS</span>
        <h2 class="section-title">3D Spatial Dimensions</h2>
        <p class="section-sub">Hardware-accelerated perspective transforms and tactile physical interactions. Pure CSS.</p>
      </div>
      <a href="/playground" class="vibe-badge vibe-badge--neon" style="flex-shrink:0;">Try in Playground →</a>
    </div>

    <div class="vibe-grid">
      <!-- 3D Flip Card -->
      <div class="card-3d-flip">
        <div class="card-3d-inner">
          <div class="card-3d-front" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:1.5rem;">
            <span class="vibe-badge vibe-badge--neon" style="margin-bottom:0.5rem;">3D PERSPECTIVE</span>
            <h3 class="text-gradient" style="font-size:1.6rem;font-weight:900;">Hover to Flip</h3>
            <small style="color:#94a3b8; margin-top:6px;">GPU composited 180° rotation</small>
          </div>
          <div class="card-3d-back" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:1.5rem;">
            <h3 class="text-cyber" style="font-size:1.4rem;font-weight:900;">180° Back Face</h3>
            <p style="font-size: 0.85rem; margin:10px 0; color:#cbd5e1;">Single class. Zero script runtime.</p>
            <button class="btn-3d btn-3d--cyan --sm">Tactile Button</button>
          </div>
        </div>
      </div>

      <!-- Physical Tactile 3D Buttons -->
      <div class="vibe-card stack justify-between p-6">
        <header>
          <span class="vibe-badge">.btn-3d</span>
          <h3 style="margin-top: 0.5rem;">Physical Tactile 3D Buttons</h3>
          <small style="color:#94a3b8;">Real extruded depth &amp; press-down spring</small>
        </header>
        <div style="display:flex; flex-direction:column; gap:0.85rem; margin:1rem 0;">
          <button class="btn-3d">Press Down (.btn-3d)</button>
          <button class="btn-3d btn-3d--cyan">Cyan Neon Button</button>
          <button class="btn-3d btn-3d--sunset">Sunset Flare Button</button>
        </div>
        <footer>
          <small style="color:#64748b;">Active spring physics built-in</small>
        </footer>
      </div>

      <!-- Interactive 3D Book -->
      <div class="vibe-card stack justify-between p-6">
        <header>
          <span class="vibe-badge vibe-badge--sunset">.book-3d</span>
          <h3 style="margin-top: 0.5rem;">Interactive 3D Book</h3>
          <small style="color:#94a3b8;">Hover or click to turn realistic pages in pure CSS</small>
        </header>
        
        <div class="book-3d" id="demo-book" style="margin: 1rem auto;" title="Click or hover to turn pages">
          <div class="book-cover">
            <div>
              <span class="vibe-badge" style="font-size: 0.62rem; background:rgba(212,175,55,0.15); color:#e6ca65; border-color:rgba(212,175,55,0.35);">VOL. I</span>
              <strong style="color: #f5f0e8; font-size: 1.05rem; display:block; margin-top:8px; line-height:1.2; letter-spacing:0.02em; font-family:serif; font-style:italic;">The Tactile Web</strong>
              <small style="color: #94a3b8; font-size: 0.65rem; display:block; margin-top:2px;">A pure CSS interactive tome</small>
            </div>
            <small style="color: #e6ca65; font-size: 0.72rem; font-weight:700;">Hover or click to open 📖</small>
          </div>
          <div class="book-pages">
            <div class="page --page1">
              <h4>I. The Paper</h4>
              <p>Realistic aged parchment gradient with natural fiber crease shadows.</p>
            </div>
            <div class="page --page2">
              <h4>II. The Physics</h4>
              <p>Staggered cubic-bezier page-turn deceleration with natural paper weight.</p>
            </div>
            <div class="page --page3">
              <h4>III. Zero JS</h4>
              <p>100% pure hardware-accelerated 3D transforms. No JavaScript needed.</p>
            </div>
            <div class="page --page4">
              <h4>IV. Your Turn</h4>
              <p>Add <code>.book-3d</code> to any element to craft your own interactive storybook.</p>
            </div>
          </div>
        </div>

        <footer>
          <small style="color:#64748b;"><code>transform-style: preserve-3d</code> &bull; Click or hover</small>
        </footer>
      </div>
    </div>
  </section>

  <!-- ── TOTAL DESIGN FREEDOM ────────────────────────────────────── -->
  <hr class="section-divider" id="design-freedom" />
  <section class="stack gap-4">
    <div class="section-header-row" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
      <div class="section-header">
        <span class="section-eyebrow" style="color:#f97316; background:rgba(249,115,22,0.1); border-color:rgba(249,115,22,0.25);">⚙️ Override System</span>
        <h2 class="section-title">Total Design Freedom</h2>
        <p class="section-sub"><em>"Unboilerplate gives you a starting point. You decide the destination."</em></p>
      </div>
      <a href="/playground" class="pill-tab" style="flex-shrink:0;">Test Overrides →</a>
    </div>

    <div class="vibe-grid">
      <div class="vibe-card p-6 stack gap-3">
        <span class="vibe-badge">METHOD 1: CSS VARIABLES</span>
        <h3>Override With Custom Properties</h3>
        <p style="color:#94a3b8; font-size: 0.88rem;">Adjust any property directly on the element without breaking the class architecture.</p>
        
        <div class="vibe-card" style="--card-bg: linear-gradient(135deg, #ff007a, #7928ca); --card-radius: 12px; --card-padding: 1.25rem; --card-border: 2px solid #ff007a; margin-top:0.75rem;">
          <strong style="color: #fff; font-size: 0.95rem;">Custom Styled Card</strong>
          <code style="color: #00f2fe; font-size: 0.75rem; margin-top: 4px; display:block;">style="--card-bg: ...; --card-radius: 12px;"</code>
        </div>
      </div>

      <div class="vibe-card p-6 stack gap-3">
        <span class="vibe-badge vibe-badge--sunset">METHOD 2: CONIC GRADIENT GLOW</span>
        <h3>Conic Glow Card</h3>
        <p style="color:#94a3b8; font-size: 0.88rem;">Continuous 360° gradient border rotation powered by CSS keyframes.</p>
        
        <div class="card-conic-glow" style="margin-top:0.75rem;">
          <div class="card-conic-content p-6 text-center">
            <h3 class="text-gradient --sunset" style="font-size: 1.5rem;">360° Rotation</h3>
            <small style="color: #94a3b8;">Infinite spinning gradient border</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE PURE CSS CREATIVE UNIVERSE ──────────────────────────── -->
  <hr class="section-divider" id="creative-universe" />
  <section class="stack gap-4">
    <div class="section-header-row" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
      <div class="section-header">
        <span class="section-eyebrow" style="color:#00ffa3; background:rgba(0,255,163,0.1); border-color:rgba(0,255,163,0.25);">🎨 Creative Universe</span>
        <h2 class="section-title">Pure CSS Canvas</h2>
        <p class="section-sub">Art supplies for the web. Layer graphics like Photoshop, retro sites, and 3D celestial particles.</p>
      </div>
      <a href="/playground" class="vibe-btn --sm" style="flex-shrink:0;">Playground</a>
    </div>

    <div class="vibe-grid">
      <!-- Layer Sandbox -->
      <div class="vibe-card p-6 stack gap-3">
        <span class="vibe-badge vibe-badge--sunset">LAYER SANDWICH &amp; BLEND MODES</span>
        <h3>Photoshop-Grade Canvas</h3>
        <p style="color:#94a3b8; font-size: 0.9rem;">
          Stack layers with <code class="text-cyber">.canvas</code>, <code class="text-cyber">.layer-back</code>, <code class="text-cyber">.layer-mid</code>, and pure CSS blend modes.
        </p>
        <div class="canvas canvas-landscape" style="min-height: 180px; background: linear-gradient(135deg, #1f1c2c, #928dab); border-radius: 12px; position: relative;">
          <div class="layer-back bg-gradient --mesh" style="position: absolute; inset: 0;"></div>
          <div class="layer-mid" style="position: absolute; inset: 0; z-index: 2; display:flex; align-items:center; justify-content:center;">
            <span class="text-gradient --sunset" style="font-size: 2.2rem; font-weight: 900;">PURE ART</span>
          </div>
          <div class="layer-front" style="position: absolute; inset: 0; z-index: 3; display:flex; justify-content:space-between; align-items:flex-end; padding:1rem;">
            <span class="vibe-badge vibe-badge--neon">.blend-screen</span>
            <span class="vibe-badge">.layer-front</span>
          </div>
        </div>
      </div>

      <!-- Pure CSS 3D Particles -->
      <div class="vibe-card p-6 stack gap-3">
        <span class="vibe-badge vibe-badge--neon">3D PARTICLES</span>
        <h3>Zero-JS Spatial Motion</h3>
        <p style="color:#94a3b8; font-size: 0.9rem;">
          Floating stars, rising bubbles, and orbiting cosmic bodies directly in HTML.
        </p>
        <div class="particles-3d" style="min-height: 180px; background: #06070a; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; position:relative;">
          <div class="particle --float-slow">✦</div>
          <div class="particle --float-medium">✧</div>
          <div class="particle --float-fast">⭐</div>
          <div class="particle --spin">💫</div>
          <div class="particle --orbit">✨</div>
          <span class="text-gradient --ocean font-bold" style="position: relative; z-index: 10; font-size: 1.3rem;">3D Particle System</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── DESIGN MOVEMENTS ───────────────────────────────────────── -->
  <hr class="section-divider" id="art-studio" />
  <section class="stack gap-4">
    <div class="section-header">
      <span class="section-eyebrow" style="color:#ff007f; background:rgba(255,0,127,0.1); border-color:rgba(255,0,127,0.25);">🎭 Aesthetic Worlds</span>
      <h2 class="section-title">Design Movements</h2>
      <p class="section-sub">Why should every web app look like a generic corporate dashboard? Switch aesthetics with a single class.</p>
    </div>

    <div class="vibe-grid">
      <div class="brutal-neo p-6 stack justify-between">
        <header>
          <span class="vibe-badge" style="background: #000; color: #fff; border: none;">.brutal-neo</span>
          <h3 style="margin-top: 0.5rem; color: #000;">Neo-Brutalism</h3>
        </header>
        <p style="color: #222; font-weight: 600;">Hard drop shadows, thick black borders, and high-contrast confidence.</p>
        <footer>
          <button class="btn-brutal">CLAIM ACCESS</button>
        </footer>
      </div>

      <div class="card-wood stack justify-between p-6">
        <header>
          <span class="vibe-badge" style="background: rgba(0,0,0,0.6);">.card-wood</span>
          <h3 style="margin-top: 0.5rem; color: #fff;">Skeuomorphism</h3>
        </header>
        <p style="color: #e5d4c0;">Physical tactile realism with stitched leather and rich mahogany grain.</p>
        <footer>
          <button class="btn-leather">Stitched Leather</button>
        </footer>
      </div>

      <div class="vapor-sunset p-6 rounded-xl stack justify-between">
        <header>
          <span class="vibe-badge" style="background: rgba(0,0,0,0.5);">.vapor-sunset</span>
          <h3 class="vapor-chrome" style="margin-top: 0.5rem; font-size: 1.6rem;">VAPORWAVE</h3>
        </header>
        <p style="color: #ffe6ff;">80s retro grid horizon, chrome typography, and neon sunset dusk gradient.</p>
        <footer>
          <button class="vibe-btn --sm" style="background: #ff007f;">Experience</button>
        </footer>
      </div>
    </div>
  </section>

  <!-- ── CREDITS & ATTRIBUTION ──────────────────────────────────── -->
  <hr class="section-divider" id="credits" />
  <section class="stack gap-4">
    <div class="section-header-row" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
      <div class="section-header">
        <span class="section-eyebrow" style="color:#f472b6; background:rgba(244,114,182,0.1); border-color:rgba(244,114,182,0.25);">🎨 Artwork &amp; Attribution</span>
        <h2 class="section-title">Credits &amp; Inspiration</h2>
        <p class="section-sub">Honoring the artists and creative communities who inspire the visual soul of Unboilerplate.</p>
      </div>
    </div>

    <div class="vibe-grid">
      <!-- Pinterest Artist Credit -->
      <div class="vibe-card p-6 stack justify-between" style="border-color: rgba(244,114,182,0.3);">
        <div>
          <span class="vibe-badge vibe-badge--sunset">HERO ARTWORK</span>
          <h3 style="margin-top:0.6rem; font-size:1.25rem;">Hero Animation Art</h3>
          <p style="color:#cbd5e1; font-size:0.92rem; margin-top:0.5rem; line-height:1.6;">
            The hero backdrop animated visual art is created by the talented artist <strong>bzdmrsam</strong> on Pinterest.
          </p>
        </div>
        <footer style="margin-top:1.5rem;">
          <a href="https://ph.pinterest.com/bzdmrsam/" target="_blank" rel="noopener noreferrer" class="vibe-btn --sm hover-bounce" style="text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem;">
            Visit bzdmrsam on Pinterest ↗
          </a>
        </footer>
      </div>

      <!-- Unsplash Community Credit -->
      <div class="vibe-card p-6 stack justify-between">
        <div>
          <span class="vibe-badge vibe-badge--neon">PHOTOGRAPHY</span>
          <h3 style="margin-top:0.6rem; font-size:1.25rem;">Unsplash Photography</h3>
          <p style="color:#cbd5e1; font-size:0.92rem; margin-top:0.5rem; line-height:1.6;">
            Exhibition canvases, polaroids, and editorial photography provided freely by independent global creators via Unsplash.
          </p>
        </div>
        <footer style="margin-top:1.5rem;">
